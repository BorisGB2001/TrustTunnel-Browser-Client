{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.2.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/BorisGB2001/TrustTunnel-Browser-Client",
  "icons": {
    "16": "icons/icon-on-16.png",
    "32": "icons/icon-on-32.png",
    "48": "icons/icon-on-48.png",
    "128": "icons/icon-on-128.png"
  },
  "permissions": [
    "proxy",
    "storage",
    "alarms",
    "privacy",
    "tabs",
    "webRequest",
    "webRequestAuthProvider",
    "contextMenus"
  ],
  "host_permissions": [
    "https://connectivitycheck.gstatic.com/*"
  ],
  "optional_host_permissions": [
    "https://proxycheck.io/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "__MSG_titleOff__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-off-16.png",
      "32": "icons/icon-off-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-vpn": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "__MSG_cmdToggleVpn__"
    }
  },
  "minimum_chrome_version": "120"
}
